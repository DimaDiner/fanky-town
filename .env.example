# Скопируйте в файл .env и подставьте значения.
# Файл .env в репозиторий не коммитится.

BOT_TOKEN=

# Публичный адрес сайта (Telegram Web App). Локально можно подставить ngrok.
WEBAPP_URL=https://funky-town-kst.kz

# Учётные записи CRM (создаются автоматически при первом запуске, если их нет в БД)
CRM_ADMIN_LOGIN=admin
CRM_ADMIN_PASSWORD=admin485
CRM_OPERATOR_LOGIN=operator
CRM_OPERATOR_PASSWORD=operator123
CRM_BOOKER_LOGIN=casher
CRM_BOOKER_PASSWORD=cahser095

# Сессия CRM (подпись токена). На проде задайте случайную длинную строку.
# CRM_SESSION_SECRET=
# CRM_SESSION_HOURS=12

# Секрет внутренних вызовов API (бот читает настройки). На проде смените.
# INTERNAL_API_SECRET=

# DEBUG=1 открывает /docs. На проде не задавать.
# DEBUG=0
